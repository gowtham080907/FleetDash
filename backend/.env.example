PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKER_POOL_SIZE=2
WORKER_TASK_TIMEOUT_MS=5000
MAX_BATCH_SIZE=10000
JSON_BODY_LIMIT=1mb
WORKER_QUEUE_MAX_SIZE=500

# Redis Pub/Sub & Broker (Automatic fallback to in-memory broker if Redis is unavailable)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_REQUIRED=false
REDIS_CHANNEL_TELEMETRY=fleetdash:telemetry
REDIS_CONNECT_TIMEOUT_MS=3000
BROKER_MODE=redis

# Socket.IO & Ingestion Transport
SOCKET_PATH=/socket.io
SOCKET_BATCH_INTERVAL_MS=50
SOCKET_MAX_BATCH_RECORDS=500
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
INGEST_MAX_QUEUE=10000

# Authentication & JWT
JWT_SECRET=fleetdash_jwt_secret_dev_key_2026_super_secure
JWT_EXPIRES_IN=24h
DATA_DIR=data
